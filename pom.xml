<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator của dự án (không phải parent): mỗi module giữ pom và phiên bản Java riêng.
    bigdata          Hadoop MapReduce V1–V5 (Java 11) + job Spark (Java 17, profile spark)  -> bigdata/target/*.jar
    webapp/backend   Spring Boot: đọc serving artifact, suy luận K-Means/KNN (Java 21)       -> webapp/backend/target/revenue-webapp.jar
  Frontend React (webapp/frontend) build bằng npm; notebook ML ở notebooks/.

  Build một module: ./mvnw -pl bigdata package   hoặc   ./mvnw -pl webapp/backend package
  Container MapReduce chạy JDK 11 nên chỉ thấy module bigdata (webapp/backend cần JDK >= 17).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>vn.edu.bigdata</groupId>
  <artifactId>ptit-bigdata</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>PTIT Big Data - Bai 21 Group By Aggregation</name>

  <modules>
    <module>bigdata</module>
  </modules>

  <profiles>
    <profile>
      <id>webapp</id>
      <activation><jdk>[17,)</jdk></activation>
      <modules>
        <module>webapp/backend</module>
      </modules>
    </profile>
  </profiles>
</project>
