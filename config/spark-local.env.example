# Sao chép thành config/spark-local.env (không commit) và sửa theo máy của bạn.
# Spark 4.0 cần JDK 17 hoặc 21 (không dùng JDK 25/26).
JAVA_HOME=C:\Path\To\jdk-21
# Chỉ Windows: thư mục có bin\winutils.exe và bin\hadoop.dll (Hadoop 3.x).
HADOOP_HOME=C:\Path\To\hadoop-3.x
# HDFS chạy trong Docker (docker compose up -d namenode datanode), publish trên localhost.
HDFS_URI=hdfs://localhost:8020
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=8
# HDFS simple auth: ghi vào cây /data (sở hữu bởi user hadoop), giống container bigdata.
HADOOP_USER_NAME=hadoop
