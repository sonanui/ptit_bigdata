# Cấu hình HDFS pseudo-distributed (1 NameNode + 1 DataNode) cho image apache/hadoop.
# /opt/starter.sh của image chuyển mỗi biến FILE.XML_key=value thành <property> trong $HADOOP_CONF_DIR.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

# Một DataNode nên replication bắt buộc bằng 1; block 128 MB là mặc định của Hadoop 3, ghi tường minh để báo cáo.
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.blocksize=134217728
HDFS-SITE.XML_dfs.namenode.name.dir=file:///data/namenode
HDFS-SITE.XML_dfs.datanode.data.dir=file:///data/datanode

# Container có IP thay đổi sau mỗi lần tạo lại; lắng nghe mọi interface để client trong mạng Compose và host đều vào được.
HDFS-SITE.XML_dfs.namenode.rpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.http-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
